{
  "name": "jarvis-mobile",
  "version": "2.0.0",
  "private": true,
  "description": "J.A.R.V.I.S. telefon uygulaması (PWA + Android)",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android && node scripts/patch-android.mjs",
    "android:icons": "capacitor-assets generate --android --iconBackgroundColor #03070a --splashBackgroundColor #03070a",
    "serve": "npx --yes http-server www -p 8080 -c-1"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
